__pycache__/

# Comparator PDFs are useful working artifacts but we don't have
# redistribution rights to publish them in a public repo.  Keep them
# locally; future sessions can re-fetch from the citations and links
# in comparators/INDEX.md.
comparators/*.pdf

# LaTeX build artifacts from convert_to_tex.py / pdflatex.
# paper.tex IS committed (a checkpoint of the current paper.md → LaTeX
# conversion); paper.pdf and intermediate logs are not.
paper.pdf
paper.aux
paper.log
paper.out
paper.toc
paper.bbl
paper.blg
paper.synctex.gz
paper.fdb_latexmk
paper.fls

